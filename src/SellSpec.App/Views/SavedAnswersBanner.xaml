<UserControl x:Class="SellSpec.App.Views.SavedAnswersBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SellSpec.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}">
  <!-- Offers answers remembered from an earlier session for this device model. DataContext is the ShellViewModel. -->
  <StackPanel>
    <Border Style="{StaticResource InfoBar}" Margin="0,0,0,12" Visibility="{Binding Session.HasSavedAnswersOffer, Converter={StaticResource BoolToVisibility}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Content="Restore" Style="{StaticResource AccentButton}" Command="{Binding RestoreSavedAnswersCommand}" Margin="0,0,8,0" AutomationProperties.Name="Restore saved answers" />
          <Button Content="Discard" Style="{StaticResource SubtleButton}" Command="{Binding DiscardSavedAnswersCommand}" AutomationProperties.Name="Discard saved answers" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Saved answers found for this model" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Session.SavedAnswersOfferDetail}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>
    <TextBlock Text="{Binding Session.SavedAnswersStatus}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,12"
               Visibility="{Binding Session.SavedAnswersStatus, Converter={StaticResource StringToVisibility}}" />
  </StackPanel>
</UserControl>
