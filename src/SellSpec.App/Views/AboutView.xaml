<UserControl x:Class="SellSpec.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SellSpec.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}">
  <ScrollViewer>
    <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="820" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
        <Image Source="/Assets/SellSpec.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="SellSpec" Style="{StaticResource TitleText}" />
          <TextBlock Text="{Binding Tagline}" Style="{StaticResource SecondaryText}" />
          <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
        </StackPanel>
      </StackPanel>

      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Privacy" FontWeight="SemiBold" Margin="0,0,0,6" />
          <TextBlock Text="{Binding PrivacyStatement}" Style="{StaticResource SecondaryText}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="What the figures mean" FontWeight="SemiBold" Margin="0,0,0,6" />
          <TextBlock Style="{StaticResource SecondaryText}" Text="Battery health is the battery's current full-charge capacity divided by its design capacity, as reported by the device. It is an estimate of remaining capacity, not a guarantee of runtime or safety. Storage health comes from Windows and the drive's own self-monitoring. Memory upgrade options are never confirmed by SellSpec; check the manufacturer's documentation. Values marked Estimated are derived (for example screen size from the panel's reported dimensions)." />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Third-party components" FontWeight="SemiBold" Margin="0,0,0,6" />
          <TextBlock Text="{Binding ThirdPartyNotices}" Style="{StaticResource SecondaryText}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Environment" FontWeight="SemiBold" Margin="0,0,0,6" />
          <TextBlock Text="{Binding Runtime}" Style="{StaticResource CaptionText}" />
          <TextBlock Text="Running with administrator rights." Style="{StaticResource CaptionText}" Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="Demonstration mode (fictional device)." Style="{StaticResource CaptionText}" Visibility="{Binding IsDemo, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="Copyright © 2026 SellSpec contributors. Free software under the MIT Licence." Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
