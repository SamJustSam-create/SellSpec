<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:SellSpec.App.ViewModels"
                    xmlns:views="clr-namespace:SellSpec.App.Views">
  <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><views:OverviewView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:SpecificationsViewModel}"><views:SpecificationsView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:DeviceHealthViewModel}"><views:DeviceHealthView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:HardwareTestsViewModel}"><views:HardwareTestsView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:CreateListingViewModel}"><views:CreateListingView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:ExportReportViewModel}"><views:ExportReportView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:PrivacyChecklistViewModel}"><views:PrivacyChecklistView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:AboutViewModel}"><views:AboutView /></DataTemplate>

  <!-- Shared page header -->
  <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleText}">
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style x:Key="PageSubtitle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
    <Setter Property="Margin" Value="0,0,0,20" />
  </Style>
</ResourceDictionary>
