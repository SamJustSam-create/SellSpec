<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Typography: Segoe UI Variable on Windows 11, Segoe UI on Windows 10. -->
  <FontFamily x:Key="FontBody">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="FontIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>

  <sys:Double x:Key="FontSizeCaption">12</sys:Double>
  <sys:Double x:Key="FontSizeBody">14</sys:Double>
  <sys:Double x:Key="FontSizeBodyLarge">16</sys:Double>
  <sys:Double x:Key="FontSizeSubtitle">20</sys:Double>
  <sys:Double x:Key="FontSizeTitle">24</sys:Double>
  <sys:Double x:Key="FontSizeMetric">22</sys:Double>

  <!-- Spacing and shape -->
  <Thickness x:Key="PagePadding">32,24,32,24</Thickness>
  <Thickness x:Key="CardPadding">16</Thickness>
  <CornerRadius x:Key="RadiusControl">4</CornerRadius>
  <CornerRadius x:Key="RadiusCard">8</CornerRadius>
  <sys:Double x:Key="NavWidth">232</sys:Double>
  <sys:Double x:Key="NavCompactWidth">52</sys:Double>
  <sys:Double x:Key="SpecCardWidth">264</sys:Double>

  <!-- Icon glyphs (Segoe Fluent Icons / MDL2 Assets, present in both) -->
  <sys:String x:Key="IconHome">&#xE80F;</sys:String>
  <sys:String x:Key="IconSpecs">&#xE7C3;</sys:String>
