<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SellSpec.App</RootNamespace>
    <AssemblyName>SellSpec</AssemblyName>
    <ApplicationIcon>Assets\SellSpec.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>SellSpec.App.Program</StartupObject>
    <AssemblyTitle>SellSpec</AssemblyTitle>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <TieredPGO>true</TieredPGO>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SellSpec.Core\SellSpec.Core.csproj" />
    <ProjectReference Include="..\SellSpec.Windows\SellSpec.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- MVVM source generators (MIT licence, Microsoft/.NET Foundation). -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\SellSpec.ico" />
    <Resource Include="Assets\SellSpec.png" />
  </ItemGroup>
</Project>
